FROM alpine:latest

RUN apk add --no-cache zip bash curl mariadb mariadb-client tzdata \
    && apk add --no-cache mariadb-server-utils \
    && apk add --no-cache procps \
    && apk add --no-cache shadow

# Set the timezone (e.g., Asia/Tehran)
ENV TZ=Asia/Tehran
RUN cp /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

COPY backup.sh /usr/local/bin/backup.sh
RUN chmod +x /usr/local/bin/backup.sh

# Fix line endings and verify script
RUN sed -i 's/\r$//' /usr/local/bin/backup.sh
RUN head -1 /usr/local/bin/backup.sh
RUN ls -la /usr/local/bin/backup.sh

# Use existing mysql user/group or create if needed
RUN addgroup mysql 2>/dev/null || true && \
    adduser -D mysql 2>/dev/null || true && \
    adduser mysql mysql 2>/dev/null || true

# Create necessary directories
RUN mkdir -p /var/lib/mysql /var/run/mysqld /var/log/mysql \
    && chown -R mysql:mysql /var/lib/mysql /var/run/mysqld /var/log/mysql

RUN echo "*/10 * * * * /bin/bash /usr/local/bin/backup.sh" >> /etc/crontabs/root

CMD ["crond", "-f"]
